# Variables del stack de dos réplicas con Nginx (CE2-9). Copiar a .env.replicas, que no se commitea.

ADMIN_INITIAL_PASSWORD=Pica2026!
APP_WEB_URL=http://localhost:5173
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080

# Para probar el login con Google hacen falta las credenciales reales, con
# http://localhost:8080/login/oauth2/code/google como URI de redirección autorizada.
GOOGLE_CLIENT_ID=google-client-id-placeholder
GOOGLE_CLIENT_SECRET=google-client-secret-placeholder

# Claves RSA compartidas para que los tokens emitidos por una réplica sean válidos en la otra.
# Se generan con openssl, en una sola línea cada una (ver README). Sin ellas las réplicas no arrancan.
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
