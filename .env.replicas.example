# Variables de ejemplo para el stack de dos réplicas con Nginx (CE2-9)
# Permite que ambas réplicas compartan el mismo par de claves RSA para firmar y validar JWTs.

POSTGRES_DB=tournament_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
REPLICAS_PORT=8080

ADMIN_INITIAL_PASSWORD=Pica2026!
GOOGLE_CLIENT_ID=google-client-id-placeholder
GOOGLE_CLIENT_SECRET=google-client-secret-placeholder
APP_WEB_URL=http://localhost:5173

# Claves RSA compartidas para que los tokens emitidos por una réplica sean válidos en la otra.
# Se generan con openssl, en una sola línea cada una (ver infra/README.md). Nunca se commitean.
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
