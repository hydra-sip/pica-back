# Copiar a /opt/pica/.env en la instancia y completar. Nunca se commitea.

# Dominio público (DuckDNS) apuntando a la IP elástica
DOMINIO=pica-hydra.duckdns.org

# Base de datos
POSTGRES_DB=pica
POSTGRES_USER=pica
POSTGRES_PASSWORD=

# Claves RSA del JWT, en una sola línea (ver infra/README.md)
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=

# Clave del usuario admin la primera vez que arranca
ADMIN_INITIAL_PASSWORD=

# Cliente OAuth de Google (CE2-6). Obligatorio: sin esto la API no arranca (GoogleClientCheck)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Sesión (CE2-8, opcional). Formato 15m, 24h, 7d. Sin estas variables valen los valores de abajo
APP_AUTH_ACCESS_TTL=15m       # vida del access token
APP_AUTH_REFRESH_TTL=24h      # inactividad: si no se usa la app en ese lapso, hay que volver a entrar
APP_AUTH_SESION_MAXIMA=7d     # tope desde el login, aunque se use todo el tiempo

# Mail (opcional). Sin MAIL_HOST, el link de verificación sale en los logs de la API
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
